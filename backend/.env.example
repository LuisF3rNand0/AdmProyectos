# Copiar este archivo como .env y completar los valores

# Base de datos (SQLite para desarrollo local)
DATABASE_URL="file:./dev.db"

# JWT - Cambiar por una clave segura en producción
JWT_SECRET="elg_secret_key_cambiar_esto"

# Puerto del servidor
PORT=3001
NODE_ENV=development

# Carpeta de uploads
UPLOAD_DIR=uploads

# OCR.space API Key - obtener gratis en https://ocr.space/ocrapi
OCR_SPACE_API_KEY="tu_api_key_aqui"
